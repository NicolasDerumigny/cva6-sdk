From c53b349c5da8f273df850fc5dbf8cfce20b1f494 Mon Sep 17 00:00:00 2001
From: Nicolas Derumigny <nderumigny@gmail.com>
Date: Mon, 20 Apr 2026 13:32:24 +0200
Subject: [PATCH] feat(axienet+axidma): add CVA6 cache support

---
 drivers/dma/xilinx/xilinx_dma.c               | 75 ++++++++++++++++++-
 .../net/ethernet/xilinx/xilinx_axienet_main.c | 64 ++++++++++++++++
 2 files changed, 138 insertions(+), 1 deletion(-)

diff --git a/drivers/dma/xilinx/xilinx_dma.c b/drivers/dma/xilinx/xilinx_dma.c
index fabff6020..1388b7006 100644
--- a/drivers/dma/xilinx/xilinx_dma.c
+++ b/drivers/dma/xilinx/xilinx_dma.c
@@ -50,6 +50,8 @@
 #include <linux/clk.h>
 #include <linux/io-64-nonatomic-lo-hi.h>
 
+#include <asm/cache.h>
+
 #include "../dmaengine.h"
 
 /* Register/Descriptor Offsets */
@@ -221,6 +223,56 @@
 #define XILINX_MCDMA_BD_EOP			BIT(30)
 #define XILINX_MCDMA_BD_SOP			BIT(31)
 
+
+/* Cache invalidation */
+#define Z_STRINGIFY(x) #x
+#define STRINGIFY(s) Z_STRINGIFY(s)
+
+#define RISCV_MISC_MEM_OPCOPE 0b0001111
+#define RISCV_FUNC3_CBO 0b010
+
+#define RISCV_IMM_CBO_FLUSH 0b000000000010
+#define RISCV_IMM_CBO_CLEAN 0b000000000001
+#define RISCV_IMM_CBO_INVAL 0b000000000000
+
+#define CBO_CLEAN_STR(REG) ".insn i " STRINGIFY(RISCV_MISC_MEM_OPCOPE) "," STRINGIFY(RISCV_FUNC3_CBO) ", zero," STRINGIFY(REG) "," STRINGIFY(RISCV_IMM_CBO_CLEAN)
+#define CBO_INVAL_STR(REG) ".insn i " STRINGIFY(RISCV_MISC_MEM_OPCOPE) "," STRINGIFY(RISCV_FUNC3_CBO) ", zero," STRINGIFY(REG) "," STRINGIFY(RISCV_IMM_CBO_INVAL)
+
+static void arch_dcache_flush_range(void *addr, size_t size) {
+	const size_t num_cachelines_affected = (size + L1_CACHE_BYTES-1) / L1_CACHE_BYTES;
+	uint8_t *flush_addr = addr;
+	size_t cacheline;
+
+	/* wait for any previous stores to commit */
+	 __asm__ volatile("fence rw,rw");
+
+	for(cacheline = 0; cacheline < num_cachelines_affected; cacheline++){
+		__asm__ volatile("mv t0, %0\n\t" CBO_CLEAN_STR (t0) "\n\t"::"r"(flush_addr):"t0");
+		flush_addr += L1_CACHE_BYTES;
+	}
+
+	/* need to wait for the CMO to commit */
+	__asm__ volatile("fence rw,rw");
+}
+
+static void arch_dcache_invd_range(void *addr, size_t size) {
+	const size_t num_cachelines_affected = (size + L1_CACHE_BYTES-1) / L1_CACHE_BYTES;
+	uint8_t *inval_addr = addr;
+	size_t cacheline;
+
+	/* Force ordering of in-flight transactions */
+	 __asm__ volatile("fence rw,rw");
+
+	for(cacheline = 0; cacheline < num_cachelines_affected; cacheline++){
+		__asm__ volatile("mv t0, %0\n\t" CBO_INVAL_STR (t0) "\n\t"::"r"(inval_addr):"t0");
+		inval_addr += L1_CACHE_BYTES;
+	}
+
+	/* need to wait for the CMO to commit */
+	__asm__ volatile("fence rw,rw");
+}
+
+
 /**
  * struct xilinx_vdma_desc_hw - Hardware Descriptor
  * @next_desc: Next Descriptor Pointer @0x00
@@ -649,6 +701,7 @@ static void *xilinx_dma_get_metadata_ptr(struct dma_async_tx_descriptor *tx,
 	*max_len = *payload_len = sizeof(u32) * XILINX_DMA_NUM_APP_WORDS;
 	seg = list_first_entry(&desc->segments,
 			       struct xilinx_axidma_tx_segment, node);
+	arch_dcache_invd_range(&seg->hw, sizeof(seg->hw));
 	return seg->hw.app;
 }
 
@@ -762,6 +815,7 @@ static void xilinx_dma_clean_hw_desc(struct xilinx_axidma_desc_hw *hw)
 
 	hw->next_desc = next_desc;
 	hw->next_desc_msb = next_desc_msb;
+	arch_dcache_flush_range(hw, sizeof(*hw));
 }
 
 static void xilinx_mcdma_clean_hw_desc(struct xilinx_aximcdma_desc_hw *hw)
@@ -996,6 +1050,7 @@ static u32 xilinx_dma_get_residue(struct xilinx_dma_chan *chan,
 					      struct xilinx_cdma_tx_segment,
 					      node);
 			cdma_hw = &cdma_seg->hw;
+			arch_dcache_invd_range(cdma_hw, sizeof(*cdma_hw));
 			residue += (cdma_hw->control - cdma_hw->status) &
 				   chan->xdev->max_buffer_len;
 		} else if (chan->xdev->dma_config->dmatype ==
@@ -1004,6 +1059,7 @@ static u32 xilinx_dma_get_residue(struct xilinx_dma_chan *chan,
 						struct xilinx_axidma_tx_segment,
 						node);
 			axidma_hw = &axidma_seg->hw;
+			arch_dcache_invd_range(axidma_hw, sizeof(*axidma_hw));
 			residue += (axidma_hw->control - axidma_hw->status) &
 				   chan->xdev->max_buffer_len;
 		} else {
@@ -1012,6 +1068,7 @@ static u32 xilinx_dma_get_residue(struct xilinx_dma_chan *chan,
 					   struct xilinx_aximcdma_tx_segment,
 					   node);
 			aximcdma_hw = &aximcdma_seg->hw;
+			arch_dcache_invd_range(aximcdma_hw, sizeof(*axidma_hw));
 			residue +=
 				(aximcdma_hw->control - aximcdma_hw->status) &
 				chan->xdev->max_buffer_len;
@@ -1560,7 +1617,7 @@ static void xilinx_dma_start_transfer(struct xilinx_dma_chan *chan)
 
 	reg = dma_ctrl_read(chan, XILINX_DMA_REG_DMACR);
 
-	if (chan->desc_pendingcount <= XILINX_DMA_COALESCE_MAX) {
+	if (chan->desc_pendingcount <= XILINX_DMA_COALESCE_MAX && chan->direction == DMA_MEM_TO_DEV) {
 		reg &= ~XILINX_DMA_CR_COALESCE_MAX;
 		reg |= chan->desc_pendingcount <<
 				  XILINX_DMA_CR_COALESCE_SHIFT;
@@ -1595,6 +1652,7 @@ static void xilinx_dma_start_transfer(struct xilinx_dma_chan *chan)
 					   struct xilinx_axidma_tx_segment,
 					   node);
 		hw = &segment->hw;
+		arch_dcache_invd_range(hw, sizeof(*hw));
 
 		xilinx_write(chan, XILINX_DMA_REG_SRCDSTADDR,
 			     xilinx_prep_dma_addr_t(hw->buf_addr));
@@ -1726,6 +1784,7 @@ static void xilinx_dma_complete_descriptor(struct xilinx_dma_chan *chan)
 
 			seg = list_last_entry(&desc->segments,
 					      struct xilinx_axidma_tx_segment, node);
+			arch_dcache_invd_range(&seg->hw, sizeof(seg->hw));
 			if (!(seg->hw.status & XILINX_DMA_BD_COMP_MASK) && chan->has_sg)
 				break;
 		}
@@ -1951,22 +2010,26 @@ static void append_desc_queue(struct xilinx_dma_chan *chan,
 					       struct xilinx_vdma_tx_segment,
 					       node);
 		tail_segment->hw.next_desc = (u32)desc->async_tx.phys;
+		arch_dcache_flush_range(&tail_segment->hw, sizeof(tail_segment->hw));
 	} else if (chan->xdev->dma_config->dmatype == XDMA_TYPE_CDMA) {
 		cdma_tail_segment = list_last_entry(&tail_desc->segments,
 						struct xilinx_cdma_tx_segment,
 						node);
 		cdma_tail_segment->hw.next_desc = (u32)desc->async_tx.phys;
+		arch_dcache_flush_range(&cdma_tail_segment->hw, sizeof(cdma_tail_segment->hw));
 	} else if (chan->xdev->dma_config->dmatype == XDMA_TYPE_AXIDMA) {
 		axidma_tail_segment = list_last_entry(&tail_desc->segments,
 					       struct xilinx_axidma_tx_segment,
 					       node);
 		axidma_tail_segment->hw.next_desc = (u32)desc->async_tx.phys;
+		arch_dcache_flush_range(&axidma_tail_segment->hw, sizeof(axidma_tail_segment->hw));
 	} else {
 		aximcdma_tail_segment =
 			list_last_entry(&tail_desc->segments,
 					struct xilinx_aximcdma_tx_segment,
 					node);
 		aximcdma_tail_segment->hw.next_desc = (u32)desc->async_tx.phys;
+		arch_dcache_flush_range(&aximcdma_tail_segment->hw, sizeof(aximcdma_tail_segment->hw));
 	}
 
 	/*
@@ -2100,6 +2163,7 @@ xilinx_vdma_dma_prep_interleaved(struct dma_chan *dchan,
 			hw->buf_addr = xt->src_start;
 		}
 	}
+	arch_dcache_flush_range(hw, sizeof(*hw));
 
 	/* Insert the segment into the descriptor segments list. */
 	list_add_tail(&segment->node, &desc->segments);
@@ -2231,6 +2295,7 @@ static struct dma_async_tx_descriptor *xilinx_dma_prep_peripheral_dma_vec(
 
 			if (prev)
 				prev->hw.next_desc = segment->phys;
+			arch_dcache_flush_range(hw, sizeof(*hw));
 
 			prev = segment;
 			sg_used += copy;
@@ -2249,10 +2314,12 @@ static struct dma_async_tx_descriptor *xilinx_dma_prep_peripheral_dma_vec(
 	/* For the last DMA_MEM_TO_DEV transfer, set EOP */
 	if (chan->direction == DMA_MEM_TO_DEV) {
 		segment->hw.control |= XILINX_DMA_BD_SOP;
+		arch_dcache_flush_range(&segment->hw, sizeof(segment->hw));
 		segment = list_last_entry(&desc->segments,
 					  struct xilinx_axidma_tx_segment,
 					  node);
 		segment->hw.control |= XILINX_DMA_BD_EOP;
+		arch_dcache_flush_range(&segment->hw, sizeof(segment->hw));
 	}
 
 	if (chan->xdev->has_axistream_connected)
@@ -2333,6 +2400,7 @@ static struct dma_async_tx_descriptor *xilinx_dma_prep_slave_sg(
 					memcpy(hw->app, app_w, sizeof(u32) *
 					       XILINX_DMA_NUM_APP_WORDS);
 			}
+			arch_dcache_flush_range(hw, sizeof(*hw));
 
 			sg_used += copy;
 
@@ -2351,10 +2419,12 @@ static struct dma_async_tx_descriptor *xilinx_dma_prep_slave_sg(
 	/* For the last DMA_MEM_TO_DEV transfer, set EOP */
 	if (chan->direction == DMA_MEM_TO_DEV) {
 		segment->hw.control |= XILINX_DMA_BD_SOP;
+		arch_dcache_flush_range(&segment->hw, sizeof(segment->hw));
 		segment = list_last_entry(&desc->segments,
 					  struct xilinx_axidma_tx_segment,
 					  node);
 		segment->hw.control |= XILINX_DMA_BD_EOP;
+		arch_dcache_flush_range(&segment->hw, sizeof(segment->hw));
 	}
 
 	if (chan->xdev->has_axistream_connected)
@@ -2435,6 +2505,7 @@ static struct dma_async_tx_descriptor *xilinx_dma_prep_dma_cyclic(
 
 			if (prev)
 				prev->hw.next_desc = segment->phys;
+			arch_dcache_flush_range(hw, sizeof(*hw));
 
 			prev = segment;
 			sg_used += copy;
@@ -2465,7 +2536,9 @@ static struct dma_async_tx_descriptor *xilinx_dma_prep_dma_cyclic(
 	if (direction == DMA_MEM_TO_DEV) {
 		head_segment->hw.control |= XILINX_DMA_BD_SOP;
 		segment->hw.control |= XILINX_DMA_BD_EOP;
+		arch_dcache_flush_range(&head_segment->hw, sizeof(head_segment->hw));
 	}
+	arch_dcache_flush_range(&segment->hw, sizeof(segment->hw));
 
 	return &desc->async_tx;
 
diff --git a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
index 284031fb2..9312405b1 100644
--- a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
+++ b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
@@ -63,6 +63,50 @@
 
 #define AXIENET_REGS_N		40
 
+#define CONFIG_DCACHE_LINE_SIZE 16
+#define Z_STRINGIFY(x) #x
+#define STRINGIFY(s) Z_STRINGIFY(s)
+
+#define RISCV_MISC_MEM_OPCOPE 0b0001111
+#define RISCV_FUNC3_CBO 0b010
+
+#define RISCV_IMM_CBO_FLUSH 0b000000000010
+#define RISCV_IMM_CBO_CLEAN 0b000000000001
+#define RISCV_IMM_CBO_INVAL 0b000000000000
+
+#define CBO_CLEAN_STR(REG) ".insn i " STRINGIFY(RISCV_MISC_MEM_OPCOPE) "," STRINGIFY(RISCV_FUNC3_CBO) ", zero," STRINGIFY(REG) "," STRINGIFY(RISCV_IMM_CBO_CLEAN)
+#define CBO_INVAL_STR(REG) ".insn i " STRINGIFY(RISCV_MISC_MEM_OPCOPE) "," STRINGIFY(RISCV_FUNC3_CBO) ", zero," STRINGIFY(REG) "," STRINGIFY(RISCV_IMM_CBO_INVAL)
+
+static void arch_dcache_flush_range(void *addr, size_t size) {
+	const size_t num_cachelines_affected = (size + CONFIG_DCACHE_LINE_SIZE-1) / CONFIG_DCACHE_LINE_SIZE;
+	uint8_t *flush_addr = addr;
+	size_t cacheline;
+
+	/* wait for any previous stores to commit */
+	 __asm__ volatile("fence rw,rw");
+
+	for(cacheline = 0; cacheline < num_cachelines_affected; cacheline++){
+		__asm__ volatile("mv t0, %0\n\t" CBO_CLEAN_STR (t0) "\n\t"::"r"(flush_addr):"t0");
+		flush_addr += CONFIG_DCACHE_LINE_SIZE;
+	}
+
+	/* need to wait for the CMO to commit */
+	__asm__ volatile("fence rw,rw");
+}
+
+static void arch_dcache_invd_range(void *addr, size_t size) {
+	const size_t num_cachelines_affected = (size + CONFIG_DCACHE_LINE_SIZE-1) / CONFIG_DCACHE_LINE_SIZE;
+	uint8_t *inval_addr = addr;
+	size_t cacheline;
+
+	for(cacheline = 0; cacheline < num_cachelines_affected; cacheline++){
+		__asm__ volatile("mv t0, %0\n\t" CBO_INVAL_STR (t0) "\n\t"::"r"(inval_addr):"t0");
+		inval_addr += CONFIG_DCACHE_LINE_SIZE;
+	}
+
+	/* need to wait for the CMO to commit */
+	__asm__ volatile("fence rw,rw");
+}
 static void axienet_rx_submit_desc(struct net_device *ndev);
 
 /* Match table for of_platform binding */
@@ -201,6 +245,8 @@ static void axienet_dma_bd_release(struct net_device *ndev)
 		/* A NULL skb means this descriptor has not been initialised
 		 * at all.
 		 */
+
+		arch_dcache_invd_range(lp->rx_bd_v, sizeof(lp->rx_bd_v));
 		if (!lp->rx_bd_v[i].skb)
 			break;
 
@@ -391,6 +437,8 @@ static int axienet_dma_bd_init(struct net_device *ndev)
 		desc_set_phys_addr(lp, addr, &lp->rx_bd_v[i]);
 
 		lp->rx_bd_v[i].cntrl = lp->max_frm_size;
+
+		arch_dcache_flush_range(&lp->rx_bd_v[i], sizeof(lp->rx_bd_v[i]));
 	}
 
 	axienet_dma_start(lp);
@@ -789,6 +837,7 @@ static int axienet_free_tx_chain(struct axienet_local *lp, u32 first_bd,
 
 	for (i = 0; i < nr_bds; i++) {
 		cur_p = &lp->tx_bd_v[(first_bd + i) % lp->tx_bd_num];
+		arch_dcache_invd_range(cur_p, sizeof(*cur_p));
 		status = cur_p->status;
 
 		/* If force is not specified, clean up only descriptors
@@ -818,6 +867,7 @@ static int axienet_free_tx_chain(struct axienet_local *lp, u32 first_bd,
 		wmb();
 		cur_p->cntrl = 0;
 		cur_p->status = 0;
+		arch_dcache_invd_range(cur_p, sizeof(*cur_p));
 
 		if (sizep)
 			*sizep += status & XAXIDMA_BD_STS_ACTUAL_LEN_MASK;
@@ -854,6 +904,7 @@ static inline int axienet_check_tx_bd_space(struct axienet_local *lp,
 	rmb();
 	cur_p = &lp->tx_bd_v[(READ_ONCE(lp->tx_bd_tail) + num_frag) %
 			     lp->tx_bd_num];
+	arch_dcache_invd_range(cur_p, sizeof(*cur_p));
 	if (cur_p->cntrl)
 		return NETDEV_TX_BUSY;
 	return 0;
@@ -1100,6 +1151,8 @@ axienet_start_xmit(struct sk_buff *skb, struct net_device *ndev)
 	}
 	desc_set_phys_addr(lp, phys, cur_p);
 	cur_p->cntrl = skb_headlen(skb) | XAXIDMA_BD_CTRL_TXSOF_MASK;
+	arch_dcache_flush_range(cur_p, sizeof(*cur_p));
+	arch_dcache_flush_range(skb->data, skb_headlen(skb));
 
 	for (ii = 0; ii < num_frag; ii++) {
 		if (++new_tail_ptr >= lp->tx_bd_num)
@@ -1121,10 +1174,13 @@ axienet_start_xmit(struct sk_buff *skb, struct net_device *ndev)
 		}
 		desc_set_phys_addr(lp, phys, cur_p);
 		cur_p->cntrl = skb_frag_size(frag);
+		arch_dcache_flush_range(cur_p, sizeof(*cur_p));
+		arch_dcache_flush_range(skb->data, skb_headlen(skb));
 	}
 
 	cur_p->cntrl |= XAXIDMA_BD_CTRL_TXEOF_MASK;
 	cur_p->skb = skb;
+	arch_dcache_flush_range(cur_p, sizeof(*cur_p));
 
 	tail_p = lp->tx_bd_p + sizeof(*lp->tx_bd_v) * new_tail_ptr;
 	if (++new_tail_ptr >= lp->tx_bd_num)
@@ -1219,6 +1275,7 @@ static int axienet_rx_poll(struct napi_struct *napi, int budget)
 	struct axienet_local *lp = container_of(napi, struct axienet_local, napi_rx);
 
 	cur_p = &lp->rx_bd_v[lp->rx_bd_ci];
+	arch_dcache_invd_range(cur_p, sizeof(*cur_p));
 
 	while (packets < budget && (cur_p->status & XAXIDMA_BD_STS_COMPLETE_MASK)) {
 		dma_addr_t phys;
@@ -1236,6 +1293,7 @@ static int axienet_rx_poll(struct napi_struct *napi, int budget)
 		 */
 		if (likely(skb)) {
 			length = cur_p->app4 & 0x0000FFFF;
+			arch_dcache_invd_range(skb->data, length);
 
 			phys = desc_get_phys_addr(lp, cur_p);
 			dma_unmap_single(lp->dev, phys, lp->max_frm_size,
@@ -1283,6 +1341,7 @@ static int axienet_rx_poll(struct napi_struct *napi, int budget)
 		cur_p->cntrl = lp->max_frm_size;
 		cur_p->status = 0;
 		cur_p->skb = new_skb;
+		arch_dcache_flush_range(cur_p, sizeof(*cur_p));
 
 		/* Only update tail_p to mark this slot as usable after it has
 		 * been successfully refilled.
@@ -1292,6 +1351,7 @@ static int axienet_rx_poll(struct napi_struct *napi, int budget)
 		if (++lp->rx_bd_ci >= lp->rx_bd_num)
 			lp->rx_bd_ci = 0;
 		cur_p = &lp->rx_bd_v[lp->rx_bd_ci];
+		arch_dcache_invd_range(cur_p, sizeof(*cur_p));
 	}
 
 	u64_stats_update_begin(&lp->rx_stat_sync);
@@ -1347,6 +1407,7 @@ static irqreturn_t axienet_tx_irq(int irq, void *_ndev)
 	if (!(status & XAXIDMA_IRQ_ALL_MASK))
 		return IRQ_NONE;
 
+	arch_dcache_invd_range(&lp->rx_bd_v[lp->rx_bd_ci], sizeof(lp->rx_bd_v[lp->rx_bd_ci]));
 	axienet_dma_out32(lp, XAXIDMA_TX_SR_OFFSET, status);
 
 	if (unlikely(status & XAXIDMA_IRQ_ERROR_MASK)) {
@@ -2703,6 +2764,7 @@ static void axienet_dma_err_handler(struct work_struct *work)
 
 	for (i = 0; i < lp->tx_bd_num; i++) {
 		cur_p = &lp->tx_bd_v[i];
+		arch_dcache_invd_range(cur_p, sizeof(*cur_p));
 		if (cur_p->cntrl) {
 			dma_addr_t addr = desc_get_phys_addr(lp, cur_p);
 
@@ -2723,6 +2785,7 @@ static void axienet_dma_err_handler(struct work_struct *work)
 		cur_p->app3 = 0;
 		cur_p->app4 = 0;
 		cur_p->skb = NULL;
+		arch_dcache_flush_range(cur_p, sizeof(*cur_p));
 	}
 
 	for (i = 0; i < lp->rx_bd_num; i++) {
@@ -2733,6 +2796,7 @@ static void axienet_dma_err_handler(struct work_struct *work)
 		cur_p->app2 = 0;
 		cur_p->app3 = 0;
 		cur_p->app4 = 0;
+		arch_dcache_flush_range(cur_p, sizeof(*cur_p));
 	}
 
 	lp->tx_bd_ci = 0;
-- 
